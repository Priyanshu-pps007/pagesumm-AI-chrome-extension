{
  "manifest_version": 3,
  "name": "My Client-side Summarizer",
  "description": "Client-side UI — index.html + app.js + styles.css bundled as extension popup.",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Summarizer"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self';  object-src 'self'"
  }
}